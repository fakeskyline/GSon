{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gson-converter",
  "main": "src/index.js",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
