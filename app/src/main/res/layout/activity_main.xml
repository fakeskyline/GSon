<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            app:title="GSon"
            app:titleTextAppearance="@style/TextAppearance.GSon.Toolbar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Геоданные.\nДругой формат."
            android:textColor="@color/on_surface"
            android:textSize="32sp"
            android:fontFamily="@font/ulm_extrabold"
            android:lineSpacingExtra="-2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:text="Конвертируй векторные данные локально. Без загрузки файлов в облако."
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp"
            android:fontFamily="@font/ulm_medium" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_container_low"
            app:cardCornerRadius="28dp"
            app:strokeColor="@color/outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="01  ·  ИСХОДНЫЙ ФАЙЛ"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:fontFamily="@font/ulm_extrabold"
                    android:letterSpacing="0.08" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/surface_container"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="@color/outline_variant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_file"
                            android:contentDescription=""
                            app:tint="@color/primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/selectedFile"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Файл не выбран"
                                android:textColor="@color/on_surface"
                                android:textSize="15sp"
                                android:fontFamily="@font/ulm_medium"
                                android:maxLines="2"
                                android:ellipsize="middle" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="GeoJSON · GPKG · KML · KMZ"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp"
                                android:fontFamily="@font/ulm_medium" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pickFileButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:minWidth="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="Выбрать"
                            android:textAllCaps="false"
                            android:fontFamily="@font/ulm_medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:hint="Исходный формат">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/sourceFormat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:fontFamily="@font/ulm_medium"
                        android:textColor="@color/on_surface" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="02  ·  РЕЗУЛЬТАТ"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:fontFamily="@font/ulm_extrabold"
                    android:letterSpacing="0.08" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="Целевой формат">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/targetFormat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:fontFamily="@font/ulm_medium"
                        android:textColor="@color/on_surface" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/convertButton"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="22dp"
                    android:text="Конвертировать"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:fontFamily="@font/ulm_extrabold"
                    app:icon="@drawable/ic_convert"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="14dp"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Выбери файл, исходный и целевой форматы."
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp"
                    android:fontFamily="@font/ulm_medium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/surface_container_low"
            app:cardCornerRadius="24dp"
            app:strokeColor="@color/outline_variant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Готовый файл"
                    android:textColor="@color/on_surface"
                    android:textSize="18sp"
                    android:fontFamily="@font/ulm_extrabold" />

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Результат появится здесь после конвертации."
                    android:textColor="@color/on_surface_variant"
                    android:textSize="13sp"
                    android:fontFamily="@font/ulm_medium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveButton"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="Сохранить"
                        android:textAllCaps="false"
                        android:fontFamily="@font/ulm_medium"
                        app:icon="@drawable/ic_download"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/openButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="Открыть"
                        android:textAllCaps="false"
                        android:fontFamily="@font/ulm_medium"
                        app:icon="@drawable/ic_open"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="GSon работает офлайн · файлы остаются на устройстве"
            android:textColor="@color/on_surface_variant"
            android:textSize="11sp"
            android:fontFamily="@font/ulm_medium" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
